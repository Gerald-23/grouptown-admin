# These must be public HTTPS URLs. The callback must point to the deployed
# Firebase function: https://<region>-<project>.cloudfunctions.net/hubtelPaymentWebhook
HUBTEL_CALLBACK_URL=REPLACE_WITH_HTTPS_CALLBACK_URL
HUBTEL_RETURN_URL=REPLACE_WITH_HTTPS_SUCCESS_URL
HUBTEL_CANCEL_URL=REPLACE_WITH_HTTPS_CANCEL_URL
HUBTEL_LOGO_URL=REPLACE_WITH_HTTPS_LOGO_URL
